# Salvex Auction API - Environment Configuration Example
# Copy this file to .env and configure appropriate values for your environment.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_chars

# Database Configuration (PostgreSQL Required)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salvex_auction

# Synchronous connection URL for Alembic migrations:
# DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/salvex_auction

# Explicitly allowed frontend origins for CORS (comma-separated, no wildcards)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
